{
    "version": 2,
    "capabilities": [
        {"id":"virtual-heel","name":"Virtual heel source","connection":"in-browser slider","mode":"simulated","implemented":true,"observations":[{"id":"vessel.heel","unit":"deg"}]},
        {"id":"virtual-sog","name":"Virtual SOG source","connection":"in-browser slider","mode":"simulated","implemented":true,"observations":[{"id":"vessel.speedOverGround","unit":"kn"}]},
        {"id":"virtual-stw","name":"Virtual STW source","connection":"in-browser slider","mode":"simulated","implemented":true,"observations":[{"id":"vessel.speedThroughWater","unit":"kn"}]},
        {"id":"virtual-depth","name":"Virtual depth source","connection":"in-browser slider","mode":"simulated","implemented":true,"observations":[{"id":"environment.depth","unit":"m"}]},
        {"id":"virtual-apparent-wind","name":"Virtual apparent-wind source","connection":"in-browser sliders","mode":"simulated","implemented":true,"observations":[{"id":"environment.wind.apparentSpeed","unit":"kn"},{"id":"environment.wind.apparentAngle","unit":"deg"}]},
        {"id":"recorded-nmea-rmc","name":"Recorded NMEA RMC speed","connection":"local file","mode":"file-replay","implemented":true,"observations":[{"id":"vessel.speedOverGround","unit":"kn"}]},
        {"id":"recorded-nmea-mwv","name":"Recorded NMEA MWV apparent wind","connection":"local timestamped file","mode":"file-replay","implemented":true,"observations":[{"id":"environment.wind.apparentSpeed","unit":"kn"},{"id":"environment.wind.apparentAngle","unit":"deg"}]},
        {"id":"nasa-marine-wind-candidate","name":"NASA Marine wind candidate","connection":"unknown model/interface","mode":"candidate","implemented":false,"observations":[{"id":"environment.wind.apparentSpeed","unit":"kn"},{"id":"environment.wind.apparentAngle","unit":"deg"}]}
        ,{"id":"amzerzo-st60-seaTalk1-candidate","name":"Amzer'zo ST60+ depth and speed candidate","connection":"SeaTalk1 physical interface (verification pending)","mode":"candidate","implemented":false,"observations":[{"id":"environment.depth","unit":"m"},{"id":"vessel.speedThroughWater","unit":"kn"}]}
    ],
    "observations": [
        {
            "id": "vessel.heel",
            "unit": "deg",
            "minimum": -90,
            "maximum": 90,
            "reference": "boat roll, zero upright; negative port, positive starboard"
        },
        {
            "id": "vessel.speedOverGround",
            "unit": "kn",
            "minimum": 0,
            "maximum": 20,
            "reference": "speed over ground; not speed through water"
        },
        {
            "id": "vessel.speedThroughWater",
            "unit": "kn",
            "minimum": 0,
            "maximum": 20,
            "reference": "speed through water (STW); independent from speed over ground"
        },
        {
            "id": "environment.depth",
            "unit": "m",
            "minimum": 0,
            "maximum": 100,
            "reference": "depth in metres; depth reference is unknown or uncalibrated"
        },
        {
            "id": "environment.wind.apparentSpeed",
            "unit": "kn",
            "minimum": 0,
            "maximum": 80,
            "reference": "apparent wind speed at the vessel, in knots; not true wind speed"
        },
        {
            "id": "environment.wind.apparentAngle",
            "unit": "deg",
            "minimum": -180,
            "maximum": 180,
            "reference": "apparent wind angle relative to vessel bow: 0 ahead, negative port, positive starboard; not absolute meteorological or true-wind direction"
        },
        {
            "id": "vessel.movingUnderHeel",
            "unit": "boolean",
            "kind": "derived",
            "reference": "derived condition; not a physical sensor measurement"
        }
    ],
    "transforms": [
        {
            "id": "moving-under-heel",
            "output": "vessel.movingUnderHeel",
            "type": "threshold-conjunction",
            "inputs": [
                "vessel.heel",
                "vessel.speedOverGround"
            ],
            "rules": [
                {
                    "input": "vessel.heel",
                    "absoluteAtLeast": 15
                },
                {
                    "input": "vessel.speedOverGround",
                    "atLeast": 3
                }
            ],
            "maxInputAgeMs": 30000,
            "maxSkewMs": 5000
        }
    ],
    "sources": [
        {
            "id": "virtual-heel",
            "type": "slider",
            "capability": "virtual-heel",
            "observation": "vessel.heel",
            "initial": 0
        },
        {
            "id": "fixture-heel",
            "type": "fixture",
            "observation": "vessel.heel",
            "samples": [
                -25,
                0,
                42,
                90
            ]
        },
        {
            "id": "virtual-sog",
            "type": "slider",
            "capability": "virtual-sog",
            "observation": "vessel.speedOverGround",
            "initial": 0
        },
        {
            "id": "virtual-wind-speed",
            "type": "slider",
            "capability": "virtual-apparent-wind",
            "observation": "environment.wind.apparentSpeed",
            "initial": 12
        },
        {
            "id": "virtual-stw",
            "type": "slider",
            "capability": "virtual-stw",
            "observation": "vessel.speedThroughWater",
            "initial": 0
        },
        {
            "id": "virtual-depth",
            "type": "slider",
            "capability": "virtual-depth",
            "observation": "environment.depth",
            "initial": 8
        },
        {
            "id": "virtual-wind-angle",
            "type": "slider",
            "capability": "virtual-apparent-wind",
            "observation": "environment.wind.apparentAngle",
            "initial": 35
        },
        {
            "id": "nmea-file",
            "type": "nmea-replay",
            "capability": "recorded-nmea-rmc",
            "observations": [
                "vessel.speedOverGround"
            ]
        },
        {
            "id": "nmea-mwv-file",
            "type": "nmea-replay",
            "capability": "recorded-nmea-mwv",
            "observations": ["environment.wind.apparentSpeed", "environment.wind.apparentAngle"]
        },
        {
            "id": "recording-replay",
            "type": "replay",
            "observations": [
                "vessel.heel",
                "vessel.speedOverGround",
                "vessel.speedThroughWater",
                "environment.depth",
                "environment.wind.apparentSpeed",
                "environment.wind.apparentAngle"
            ]
        }
    ],
    "defaultSources": {
        "vessel.heel": "virtual-heel",
        "vessel.speedOverGround": "virtual-sog",
        "vessel.speedThroughWater": "virtual-stw",
        "environment.depth": "virtual-depth",
        "environment.wind.apparentSpeed": "virtual-wind-speed",
        "environment.wind.apparentAngle": "virtual-wind-angle"
    },
    "presentations": [
        {
            "id": "heel-number",
            "observation": "vessel.heel",
            "type": "numeric",
            "title": "Heel"
        },
        {
            "id": "heel-gauge",
            "observation": "vessel.heel",
            "type": "gauge",
            "title": "Heel gauge"
        },
        {
            "id": "sog-number",
            "observation": "vessel.speedOverGround",
            "type": "numeric",
            "title": "Speed over ground (SOG)"
        },
        {
            "id": "sog-gauge",
            "observation": "vessel.speedOverGround",
            "type": "gauge",
            "title": "SOG gauge"
        },
        {
            "id": "sog-history",
            "observation": "vessel.speedOverGround",
            "type": "history",
            "title": "SOG history"
        },
        {"id":"stw-number","observation":"vessel.speedThroughWater","type":"numeric","title":"Speed through water (STW)"},
        {"id":"stw-history","observation":"vessel.speedThroughWater","type":"history","title":"STW history"},
        {"id":"depth-number","observation":"environment.depth","type":"numeric","title":"Depth (reference unknown)"},
        {"id":"depth-gauge","observation":"environment.depth","type":"gauge","title":"Depth scale"},
        {
            "id": "moving-condition",
            "observation": "vessel.movingUnderHeel",
            "type": "condition",
            "title": "Moving under heel"
        }
    ],
    "widgets": [
        {
            "id": "primary-speed",
            "widget": "speed",
            "inputs": {
                "speed": "vessel.speedOverGround"
            },
            "props": {
                "mode": "combined",
                "title": "Speed over ground",
                "historySeconds": 120,
                "showUnits": true,
                "scale": {
                    "min": 0,
                    "max": 12
                },
                "historyOpacity": 0.65,
                "numericPosition": "center"
            }
        },
        {
            "id": "speed-number",
            "widget": "speed",
            "inputs": {
                "speed": "vessel.speedOverGround"
            },
            "props": {
                "mode": "number",
                "title": "SOG",
                "historySeconds": 60,
                "showUnits": true,
                "scale": {
                    "min": 0,
                    "max": 12
                },
                "historyOpacity": 0.65
            }
        },
        {
            "id": "speed-history",
            "widget": "speed",
            "inputs": {
                "speed": "vessel.speedOverGround"
            },
            "props": {
                "mode": "history",
                "title": "SOG trend",
                "historySeconds": 180,
                "showUnits": true,
                "scale": {
                    "min": 0,
                    "max": 20
                },
                "historyOpacity": 0.8
            }
        },
        {"id":"primary-stw","widget":"speed","inputs":{"speed":"vessel.speedThroughWater"},"props":{"mode":"combined","title":"Speed through water (STW)","historySeconds":120,"showUnits":true,"scale":{"min":0,"max":12},"historyOpacity":0.65,"numericPosition":"center"}},
        {"id":"depth-number","widget":"depth","inputs":{"depth":"environment.depth"},"props":{"mode":"number","title":"Depth","showUnits":true,"showReference":true,"showScale":true,"referenceLabel":"REFERENCE UNKNOWN / UNCALIBRATED","scale":{"min":0,"max":30}}},
        {"id":"primary-depth","widget":"depth","inputs":{"depth":"environment.depth"},"props":{"mode":"combined","title":"Depth","showUnits":true,"showReference":true,"showScale":true,"referenceLabel":"REFERENCE UNKNOWN / UNCALIBRATED","scale":{"min":0,"max":30}}},
        {
            "id": "wind-number",
            "widget": "wind",
            "inputs": {"speed": "environment.wind.apparentSpeed", "angle": "environment.wind.apparentAngle"},
            "props": {"mode": "number", "title": "Apparent wind", "showUnits": true, "showAngle": true, "showPortStarboard": true, "speedScale": {"min": 0, "max": 40}, "pointerStyle": "arrow", "maxSkewMs": 5000}
        },
        {
            "id": "wind-dial",
            "widget": "wind",
            "inputs": {"speed": "environment.wind.apparentSpeed", "angle": "environment.wind.apparentAngle"},
            "props": {"mode": "dial", "title": "Apparent wind angle", "showUnits": true, "showAngle": true, "showPortStarboard": true, "speedScale": {"min": 0, "max": 40}, "pointerStyle": "arrow", "maxSkewMs": 5000}
        },
        {
            "id": "primary-wind",
            "widget": "wind",
            "inputs": {"speed": "environment.wind.apparentSpeed", "angle": "environment.wind.apparentAngle"},
            "props": {"mode": "combined", "title": "Apparent wind", "showUnits": true, "showAngle": true, "showPortStarboard": true, "speedScale": {"min": 0, "max": 40}, "pointerStyle": "arrow", "maxSkewMs": 5000}
        },
        {"id":"synthetic-sog","widget":"sensor-reading","props":{"binding":"sog","title":"Phone SOG · own vessel"}},
        {"id":"synthetic-remote-wind","widget":"sensor-reading","props":{"binding":"remoteWind","title":"Other boat · apparent wind"}},
        {"id":"synthetic-shore-wind","widget":"sensor-reading","props":{"binding":"shoreWind","title":"Shore station · local wind"}}
    ],
  "templates": [
    {
      "id": "sailing-hud",
      "widgets": ["primary-speed"],
      "layout": {"referenceWidth": 1540, "referenceHeight": 720, "slots": {"speed": "main", "heel": "heel"}}
    }
    ,{
      "id": "sailing-hud-wind",
      "widgets": ["primary-speed", "primary-wind"],
      "layout": {"referenceWidth": 1540, "referenceHeight": 720, "slots": {"speed": "main", "heel": "heel", "wind": "wind"}}
    }
    ,{
      "id": "wind-focused-hud",
      "widgets": ["speed-number", "primary-wind"],
      "layout": {"referenceWidth": 1540, "referenceHeight": 720, "slots": {"speed": "small", "heel": "compact", "wind": "main"}}
    }
    ,{
      "id": "sailing-hud-full",
      "widgets": ["primary-speed", "primary-wind", "primary-depth", "primary-stw"],
      "layout": {"referenceWidth": 1540, "referenceHeight": 720, "slots": {"speed": "main", "heel": "heel", "wind": "wind", "depth": "depth", "stw": "stw"}}
    }
    ,{
      "id": "synthetic-provenance-hud",
      "widgets": ["synthetic-sog", "synthetic-remote-wind", "synthetic-shore-wind"],
      "layout": {"referenceWidth": 1540, "referenceHeight": 720, "slots": {"synthetic-sog":"port", "synthetic-remote-wind":"main", "synthetic-shore-wind":"starboard"}}
    }
  ],
    "display": {
        "defaultProfile": "speed-focus",
        "profiles": {
            "engineering": {
                "presentations": [
                    "heel-number",
                    "heel-gauge",
                    "sog-number",
                    "moving-condition"
                ],
                "widgets": [],
                "layout": "engineering",
                "showControls": true,
                "showMetadata": true
            },
            "compact": {
                "presentations": [
                    "heel-number",
                    "sog-history",
                    "sog-gauge"
                ],
                "widgets": [],
                "layout": "compact",
                "showControls": false,
                "showMetadata": false
            },
            "wide": {
                "presentations": [
                    "heel-number",
                    "sog-history",
                    "sog-gauge"
                ],
                "widgets": [],
                "layout": "wide",
                "showControls": false,
                "showMetadata": true
            },
            "speed-focus": {
                "presentations": [
                    "heel-number"
                ],
                "widgets": [
                    "primary-speed"
                ],
                "layout": "wide",
                "showControls": true,
                "showMetadata": true
            },
            "instruments-trends": {
                "presentations": [
                    "heel-gauge",
                    "moving-condition"
                ],
                "widgets": [
                    "speed-number",
                    "speed-history"
                ],
                "layout": "engineering",
                "showControls": true,
                "showMetadata": true
      },
      "sailing-hud": {
        "presentations": ["heel-number", "heel-gauge"],
        "widgets": ["primary-speed"],
        "template": "sailing-hud",
        "layout": "hud",
        "showControls": false,
        "showMetadata": false
            },
      "sailing-hud-wind": {
        "presentations": ["heel-number", "heel-gauge"],
        "widgets": ["primary-speed", "primary-wind"],
        "template": "sailing-hud-wind",
        "layout": "hud",
        "showControls": false,
        "showMetadata": false
      }
      ,"wind-focused-hud": {
        "presentations": ["heel-number"],
        "widgets": ["speed-number", "primary-wind"],
        "template": "wind-focused-hud",
        "layout": "hud",
        "showControls": false,
        "showMetadata": false
      }
      ,"sailing-hud-full": {
        "presentations": ["heel-number", "heel-gauge", "depth-number", "depth-gauge", "stw-number", "stw-history"],
        "widgets": ["primary-speed", "primary-wind", "primary-depth", "primary-stw"],
        "template": "sailing-hud-full",
        "layout": "hud",
        "showControls": false,
        "showMetadata": false
      },
      "synthetic-provenance-hud": {
        "presentations": [],
        "widgets": ["synthetic-sog", "synthetic-remote-wind", "synthetic-shore-wind"],
        "template": "synthetic-provenance-hud",
        "layout": "hud",
        "showControls": false,
        "showMetadata": false
      }
        }
    }
}
